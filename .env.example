# ==============================================================================
# MasterChat Environment Configuration
# ==============================================================================

# Environment mode: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Ports & Hostnames
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
GATEWAY_PORT=8080
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
GATEWAY_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=masterchat
POSTGRES_PASSWORD=masterchat_secure_pass
POSTGRES_DB=masterchat_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://masterchat:masterchat_secure_pass@localhost:5432/masterchat_db
ASYNC_DATABASE_URL=postgresql+asyncpg://masterchat:masterchat_secure_pass@localhost:5432/masterchat_db

# ------------------------------------------------------------------------------
# Cache & Rate Limiting (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# Vector Store (ChromaDB)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_encryption_key_change_in_production_32chars!
JWT_EXPIRES_IN_MINUTES=60
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ------------------------------------------------------------------------------
# Model Providers & LLMs
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_FALLBACK_MODEL=claude-3-5-haiku-20241022

# Primary provider preference: openai | anthropic
DEFAULT_MODEL_PROVIDER=openai

# ------------------------------------------------------------------------------
# Embeddings & RAG
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4

# ------------------------------------------------------------------------------
# Observability & Tracing
# ------------------------------------------------------------------------------
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=masterchat
PROMETHEUS_METRICS=true
